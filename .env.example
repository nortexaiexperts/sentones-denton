# Copy to `.env` for local overrides. Nothing here is required for the local preview.

# Show clearly-labelled sample content (events, opportunities, articles, MTC details)
# so the layout can be reviewed. `astro dev` shows it automatically; production builds
# only include it when this is explicitly "true" (see `npm run build:preview`).
PUBLIC_PREVIEW_CONTENT=true

# Public domain (used for canonical URLs, sitemap and sharing tags).
# Registered 2026-10-17 by the client via Cloudflare. Set on the production deployment only.
# PUBLIC_SITE_URL=https://sentonesdenton.org

# Set to "true" on the production deployment only. Until then every build sends
# a noindex robots tag so staging previews never get indexed.
# PUBLIC_ALLOW_INDEXING=false

# --- Deferred until the client approves the website (phase 2) ---
# Formspree form IDs. Forms stay in preview mode (no submission) until these exist.
# PUBLIC_FORMSPREE_INQUIRY_ID=

# Sanity (build-time only, never shipped to the browser). When unset the site uses seed content.
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
