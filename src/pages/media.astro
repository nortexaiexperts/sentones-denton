---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PillarStrip from '../components/PillarStrip.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Photo from '../components/Photo.astro';
import FilterChips from '../components/FilterChips.astro';
import CtaBand from '../components/CtaBand.astro';
import EmptyState from '../components/EmptyState.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { getMedia, getSiteSettings } from '../lib/content';

const site = getSiteSettings();
const media = getMedia();
const featured = media.find((m) => m.featured) ?? media[0];
const rest = media.filter((m) => m !== featured);
const typeLabel = { video: 'Video', podcast: 'Podcast', playlist: 'Playlist', documentary: 'Documentary' };
const typesPresent = [...new Set(rest.map((m) => m.type))];
const filterOptions = [
  { value: 'podcast', label: 'Podcasts' },
  { value: 'video', label: 'Videos' },
  { value: 'playlist', label: 'Playlists' },
  { value: 'documentary', label: 'Documentaries' },
].filter((o) => typesPresent.includes(o.value as keyof typeof typeLabel));
const iconFor = (label: string) =>
  label.toLowerCase().includes('spotify') ? 'spotify' : label.toLowerCase().includes('apple') ? 'apple-podcasts' : 'link';
---

<BaseLayout
  title="Media"
  description="Videos and media from Sent Ones Denton, with links to the wider Sent Ones podcasts and documentary."
>
  <PageHeader
    kicker="Watch & listen"
    title="Media"
    lead="Stories and teaching from Denton. We are building our own library of videos, podcasts and documentaries, and will add to it over time."
  />
  <PillarStrip />

  {
    featured ? (
      <section class="section doc" id={featured.slug}>
        <div class="container doc__grid">
          <div class="doc__copy">
            <p class="eyebrow eyebrow--rule">Featured · {typeLabel[featured.type]}</p>
            <h2 class="doc__title">{featured.title}</h2>
            <p class="lead">{featured.summary}</p>
            <p class="muted small">{featured.provider}</p>
            <div class="btn-row">
              {featured.links.map((l) => (
                <a class="link link--arrow" href={l.href} target="_blank" rel="noopener">
                  {l.label}
                </a>
              ))}
            </div>
          </div>
          {featured.youtubeId ? (
            <VideoEmbed title={featured.title} youtubeId={featured.youtubeId} poster={featured.cover} />
          ) : featured.localVideo ? (
            <VideoEmbed title={featured.title} src={featured.localVideo.src} poster={{ src: featured.localVideo.poster, alt: featured.cover.alt }} />
          ) : (
            <Photo image={featured.cover} widths={[640, 960, 1280]} sizes="(min-width: 64em) 60vw, 100vw" />
          )}
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container">
          <EmptyState
            title="Denton media coming soon"
            body="Videos, podcasts and stories from the Denton team will be published here as they are produced."
            cta={{ label: 'Upcoming events', href: '/events/' }}
          />
        </div>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="section section--flush-top" id="library">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow eyebrow--rule">Library</p>
              <h2>More from Denton</h2>
            </div>
          </div>
          {filterOptions.length > 1 && (
            <FilterChips label="Filter media by type" attr="media-type" target="#media-list" options={filterOptions} />
          )}
          <div id="media-list" class="media-list">
            {rest.map((m) => (
              <article class:list={['show', { 'show--video': m.type !== 'podcast' }]} data-media-type={m.type} id={m.slug}>
                {m.type === 'podcast' ? (
                  <div class="show__cover">
                    <Photo image={m.cover} widths={[320, 480, 640]} sizes="(min-width: 48em) 18rem, 60vw" />
                  </div>
                ) : m.youtubeId ? (
                  <VideoEmbed title={m.title} youtubeId={m.youtubeId} poster={m.cover} />
                ) : m.localVideo ? (
                  <VideoEmbed title={m.title} src={m.localVideo.src} poster={{ src: m.localVideo.poster, alt: m.cover.alt }} />
                ) : (
                  <a class="show__cover show__cover--link" href={m.links[0]?.href} target="_blank" rel="noopener" aria-label={`${m.title} (opens in a new tab)`}>
                    <Photo image={m.cover} widths={[480, 768, 1024]} sizes="(min-width: 64em) 40vw, 100vw" />
                  </a>
                )}
                <div class="show__body">
                  <p class="eyebrow">{typeLabel[m.type]}</p>
                  <h3 class="show__title">{m.title}</h3>
                  <p class="show__summary">{m.summary}</p>
                  <p class="muted small">{m.provider}</p>
                  {m.links.length > 0 && (
                    <ul class="show__links">
                      {m.links.map((l) => (
                        <li>
                          <a class:list={m.type === 'podcast' ? 'btn btn--yellow btn--sm btn--pill' : 'link link--arrow'} href={l.href} target="_blank" rel="noopener">
                            {m.type === 'podcast' && <SocialIcon network={iconFor(l.label)} size={14} />}
                            {l.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    site.social.length > 0 && (
      <section class="follow section section--flush-top">
        <div class="container follow__grid">
          <div>
            <h2 class="follow__title">Follow {site.name}</h2>
            <p class="muted">New videos and stories land on our channels first.</p>
          </div>
          <ul class="follow__icons">
            {site.social.map((s) => (
              <li>
                <a class="follow__link" href={s.href} target="_blank" rel="noopener">
                  <SocialIcon network={s.network} size={20} />
                  <span>{s.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- National media: linked, never featured (client rule) -->
  <section class="national theme-ink section">
    <div class="container national__grid">
      <div>
        <p class="eyebrow eyebrow--rule">From the wider family</p>
        <h2 class="national__title">More from Sent Ones</h2>
        <p class="muted">
          Podcasts, the documentary and the blog from the national Sent Ones team live on
          <a class="text-link" href={site.nationalSite.href} target="_blank" rel="noopener">{site.nationalSite.label}</a>.
        </p>
      </div>
      <ul class="national__links">
        {
          site.nationalMediaLinks.map((l) => (
            <li>
              <a class="national__link" href={l.href} target="_blank" rel="noopener">
                <span>{l.label}</span>
                <span aria-hidden="true">↗</span>
                <span class="visually-hidden">(opens sentones.com in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title="Ready for more than watching?"
    body="Take what you see into practice at a Denton training, or talk through your next step with a coach."
    primary={{ label: 'Rhythms & events', href: '/events/' }}
    secondary={{ label: 'Coaching', href: '/resources/#coaching' }}
    tone="orange"
  />
</BaseLayout>

<style>
  .doc__grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 64em) {
    .doc__grid {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-8);
      align-items: center;
    }
  }
  .doc__title {
    font-size: var(--fs-h2);
    color: var(--c-yellow);
  }
  .media-list {
    display: grid;
    gap: var(--space-6);
  }
  .show {
    --accent-text: var(--c-orange-ink);
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--bg-panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    align-items: center;
  }
  @media (min-width: 48em) {
    .show {
      grid-template-columns: 16rem 1fr;
      gap: var(--space-7);
    }
    .show--video {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .show[hidden] {
    display: none;
  }
  .show__cover {
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--c-black);
  }
  .show__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show__cover--link {
    aspect-ratio: 16 / 9;
  }
  .show__title {
    font-size: var(--fs-h2);
    color: var(--c-yellow);
    margin-bottom: var(--space-3);
  }
  .show__summary {
    font-weight: 600;
    max-width: 40rem;
  }
  .show__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
  }
  .follow__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--bg-panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  .follow__title {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-1);
  }
  .follow__grid p {
    margin: 0;
  }
  .follow__icons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .follow__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.1rem;
    border: 2px solid var(--rule);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .follow__link:hover {
    background: var(--c-yellow);
    border-color: var(--c-yellow);
    color: var(--c-black);
  }
  .national__grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 64em) {
    .national__grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
  .national__title {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-3);
  }
  .national__links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .national__link {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s var(--ease);
  }
  .national__link:hover {
    color: var(--c-yellow);
  }
</style>
