---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import EventCard from '../../components/EventCard.astro';
import { getAllEvents, getUpcomingEvents } from '../../lib/content';
import { formatDate, formatEventRange, formatTime, formatTzAbbr, isPast } from '../../lib/format';
import type { Event } from '../../lib/types';

export function getStaticPaths() {
  return getAllEvents().map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

const { event } = Astro.props as { event: Event };
const past = isPast(event);
const when = formatEventRange(event.start, event.end, event.timezone);
const more = getUpcomingEvents()
  .filter((e) => e.slug !== event.slug)
  .slice(0, 2);
const typeLabel = event.type === 'training' ? 'Training' : 'Worship';
const noindex = event.status === 'demo';
---

<BaseLayout title={event.title} description={event.summary} article noindex={noindex}>
  <article class="ev">
    <header class="ev__header">
      <div class="container ev__header-inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/events/">Events</a>
        </nav>
        <div class="ev__badges">
          <span class:list={['badge', event.type === 'training' ? 'badge--orange' : 'badge--yellow']}>{typeLabel}</span>
          {past && <span class="badge badge--outline">Past event</span>}
          <SampleBadge status={event.status} />
        </div>
        <h1 class="ev__title">{event.title}</h1>
        <p class="ev__when">{when}</p>
      </div>
    </header>

    <div class="container ev__layout">
      <div class="ev__main">
        <div class="ev__media">
          <Photo image={event.image} widths={[640, 960, 1280]} sizes="(min-width: 64em) 60vw, 100vw" priority />
        </div>
        <div class="prose ev__prose">
          <p class="lead">{event.summary}</p>
          {event.description.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <aside class="ev__aside">
        <div class="ev__details">
          <h2 class="ev__details-title">Details</h2>
          <dl>
            <dt>Date</dt>
            <dd>{formatDate(event.start, event.timezone)}</dd>
            <dt>Time</dt>
            <dd>
              {formatTime(event.start, event.timezone)}
              {event.end ? ` – ${formatTime(event.end, event.timezone)}` : ''} {formatTzAbbr(event.start, event.timezone)}
            </dd>
            <dt>Where</dt>
            <dd>
              {event.venue.name}
              <br />
              {event.venue.address && (
                <>
                  {event.venue.address}
                  <br />
                </>
              )}
              {event.venue.city}
            </dd>
            <dt>Cost</dt>
            <dd>{event.cost ?? 'Free'}</dd>
          </dl>
          {
            !past && event.registration ? (
              <a class="btn btn--yellow ev__register" href={event.registration.href} target={event.registration.external ? '_blank' : undefined} rel={event.registration.external ? 'noopener' : undefined}>
                {event.registration.label}
              </a>
            ) : !past ? (
              <a class="btn btn--yellow ev__register" href="/resources/#questions">
                I'm interested
              </a>
            ) : (
              <p class="muted small">This event has already taken place.</p>
            )
          }
          {
            event.status === 'demo' && (
              <p class="small muted ev__note">
                Sample event for layout review. Registration links are placeholders.
              </p>
            )
          }
        </div>
        <a class="link link--arrow ev__back" href="/events/">All events</a>
      </aside>
    </div>

    {
      more.length > 0 && (
        <section class="section ev__more">
          <div class="container">
            <div class="section-head">
              <h2>More upcoming events</h2>
              <a class="link link--arrow" href="/events/">All events</a>
            </div>
            <div class="grid-2">
              {more.map((e) => (
                <EventCard event={e} variant="tile" />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .ev__header {
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--space-6);
    border-bottom: 3px solid var(--c-orange);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--c-yellow);
  }
  .ev__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .ev__title {
    font-size: var(--fs-display);
    color: var(--c-yellow);
    max-width: 18ch;
    margin-bottom: var(--space-3);
  }
  .ev__when {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-orange);
  }
  .ev__layout {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--section-sm);
  }
  @media (min-width: 64em) {
    .ev__layout {
      grid-template-columns: 1.6fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
  .ev__media {
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: var(--space-6);
    aspect-ratio: 16 / 9;
    background: var(--c-grey-800);
  }
  .ev__media :global(picture),
  .ev__media :global(img) {
    width: 100%;
    height: 100%;
  }
  .ev__media :global(img) {
    object-fit: cover;
  }
  .ev__aside {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
  }
  .ev__details {
    --accent-text: var(--c-orange-ink);
    background: var(--bg-panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
  }
  .ev__details-title {
    font-size: var(--fs-h4);
    color: var(--c-orange);
  }
  .ev__details dl {
    margin: 0 0 var(--space-5);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1.25rem;
    font-size: var(--fs-small);
  }
  .ev__details dt {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.6875rem;
    color: var(--text-muted);
    padding-top: 0.2em;
  }
  .ev__details dd {
    margin: 0;
  }
  .ev__register {
    width: 100%;
  }
  .ev__note {
    margin: var(--space-3) 0 0;
  }
  .ev__more {
    border-top: 1px solid var(--rule);
  }
</style>
