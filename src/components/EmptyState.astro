---
import type { Link } from '../lib/types';
interface Props {
  title: string;
  body: string;
  cta?: Link;
}
const { title, body, cta } = Astro.props;
---

<div class="empty">
  <h3 class="empty__title">{title}</h3>
  <p class="empty__body">{body}</p>
  {cta && <a class="btn btn--yellow" href={cta.href}>{cta.label}</a>}
</div>

<style>
  .empty {
    padding: clamp(2.5rem, 6vw, 4rem);
    border: 2px dashed var(--rule);
    border-radius: var(--radius);
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
  }
  .empty__title {
    font-size: var(--fs-h3);
    color: var(--c-yellow);
  }
  .empty__body {
    max-width: 32rem;
    margin: 0 auto var(--space-5);
    color: var(--text-muted);
  }
</style>
