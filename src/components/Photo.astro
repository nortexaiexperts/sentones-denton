---
/**
 * Renders an ImageRef from the content layer. Local photos are optimised through
 * astro:assets; URLs and /public paths render as a plain <img>.
 */
import { Picture } from 'astro:assets';
import type { ImageRef } from '../lib/types';
import { isLocalImage, resolveImage } from '../lib/images';

interface Props {
  image: ImageRef;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  /** Aspect ratio crop for local images, e.g. 4/3 → width/height passed to the service. */
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}

const {
  image,
  widths = [480, 768, 1024, 1280],
  sizes = '(min-width: 64em) 50vw, 100vw',
  priority = false,
  class: className = '',
  width,
  height,
  loading,
} = Astro.props;

const resolved = resolveImage(image.src);
// Never ask the image service to upscale: keep widths at or below the source width.
const localWidths = isLocalImage(resolved)
  ? (() => {
      const w = widths.filter((x) => x < resolved.width);
      w.push(resolved.width);
      return w;
    })()
  : widths;
---

{
  isLocalImage(resolved) ? (
    <Picture
      src={resolved}
      alt={image.alt}
      widths={localWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={78}
      priority={priority}
      loading={loading ?? (priority ? 'eager' : 'lazy')}
      width={width}
      height={height}
      class={className}
      pictureAttributes={{ class: `photo ${className}`.trim() }}
    />
  ) : (
    <img
      src={resolved}
      alt={image.alt}
      class={className}
      loading={loading ?? (priority ? 'eager' : 'lazy')}
      decoding="async"
      width={width}
      height={height}
    />
  )
}
