---
import type { Event } from '../lib/types';
import { dateParts, formatEventRange } from '../lib/format';
import Photo from './Photo.astro';
import SampleBadge from './SampleBadge.astro';

interface Props {
  event: Event;
  variant?: 'row' | 'tile';
  past?: boolean;
}
const { event, variant = 'row', past = false } = Astro.props;
const { month, day } = dateParts(event.start, event.timezone);
const when = formatEventRange(event.start, event.end, event.timezone);
const typeLabel = event.type === 'training' ? 'Training' : 'Worship';
const href = `/events/${event.slug}/`;
---

<article class:list={['event', `event--${variant}`, { 'event--past': past }]} data-event-type={event.type}>
  <a class="event__media" href={href} tabindex="-1" aria-hidden="true">
    <Photo image={event.image} widths={[400, 640, 960]} sizes="(min-width: 64em) 30vw, 100vw" class="event__img" />
    <span class="event__date" aria-hidden="true">
      <span class="event__month">{month}</span>
      <span class="event__day">{day}</span>
    </span>
  </a>
  <div class="event__body">
    <div class="event__meta">
      <span class:list={['badge', event.type === 'training' ? 'badge--orange' : 'badge--yellow']}>{typeLabel}</span>
      {past && <span class="badge badge--outline">Past event</span>}
      <SampleBadge status={event.status} />
    </div>
    <h3 class="event__title"><a href={href}>{event.title}</a></h3>
    <p class="event__when">
      <span class="event__time">{when}</span>
      <span class="event__place">{event.venue.online ? 'Online' : event.venue.city}</span>
    </p>
    <p class="event__summary">{event.summary}</p>
    <div class="event__actions">
      <a class="link link--arrow" href={href}>Event details</a>
      {
        !past && event.registration && (
          <a class="btn btn--yellow btn--sm" href={event.registration.href} target={event.registration.external ? '_blank' : undefined} rel={event.registration.external ? 'noopener' : undefined}>
            {event.registration.label}
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .event {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 2px solid var(--c-orange);
  }
  .event--past {
    border-top-color: var(--rule);
  }
  .event__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-grey-800);
  }
  .event__media :global(picture),
  .event__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .event__media :global(img) {
    transition: transform 0.6s var(--ease);
  }
  .event:hover .event__media :global(img) {
    transform: scale(1.03);
  }
  .event--past .event__media :global(img) {
    filter: grayscale(0.6);
  }
  .event__date {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.4rem;
    padding: 0.4rem 0.5rem 0.3rem;
    background: var(--c-yellow);
    color: var(--c-black);
    border-radius: var(--radius);
    line-height: 1;
  }
  .event--past .event__date {
    background: var(--c-grey-300);
  }
  .event__month {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }
  .event__day {
    font-family: var(--font-display);
    font-size: 1.9rem;
    margin-top: 0.1rem;
  }
  .event__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .event__title {
    font-size: var(--fs-h3);
    color: var(--c-yellow);
    margin: 0;
  }
  .event--past .event__title {
    color: var(--c-white);
  }
  .event__title a {
    text-decoration: none;
    color: inherit;
  }
  .event__title a:hover {
    color: var(--c-white);
    text-decoration: underline;
    text-underline-offset: 0.1em;
    text-decoration-thickness: 2px;
  }
  .event--past .event__title a:hover {
    color: var(--c-yellow);
  }
  .event__when {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-text);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .event__place {
    color: var(--c-white);
    opacity: 0.85;
  }
  @media (min-width: 48em) {
    .event--row .event__when {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .event--row .event__place::before {
      content: '|';
      margin-right: 0.5rem;
      color: var(--accent-text);
      opacity: 0.6;
    }
  }
  .event__summary {
    margin: 0;
    max-width: 40rem;
    color: var(--text-muted);
  }
  .event__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-2);
  }
  @media (min-width: 48em) {
    .event--row {
      grid-template-columns: minmax(14rem, 1fr) 2fr;
      align-items: start;
      gap: var(--space-7);
    }
  }
  /* tile variant (homepage) */
  .event--tile {
    --accent-text: var(--c-orange-ink);
    padding-block: 0;
    border-top: 0;
    background: var(--bg-panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    gap: 0;
  }
  .event--tile .event__media {
    border-radius: 0;
  }
  .event--tile .event__body {
    padding: var(--space-5);
  }
  .event--tile .event__title {
    font-size: var(--fs-h4);
  }
  .event--tile .event__summary {
    display: none;
  }
</style>
