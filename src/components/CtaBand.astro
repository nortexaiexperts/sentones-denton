---
import type { Link } from '../lib/types';

interface Props {
  title: string;
  body?: string;
  primary: Link;
  secondary?: Link | null;
  tone?: 'black' | 'yellow' | 'orange' | 'ink';
  id?: string;
}
const { title, body, primary, secondary, tone = 'black', id } = Astro.props;
const themeClass = { black: 'theme-dark', yellow: 'theme-yellow', orange: 'theme-orange', ink: 'theme-ink' }[tone];
---

<section class:list={['cta', themeClass, `cta--${tone}`]} id={id}>
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 class="cta__title">{title}</h2>
      {body && <p class="lead cta__body">{body}</p>}
    </div>
    <div class="btn-row cta__actions">
      <a class:list={['btn', tone === 'yellow' || tone === 'orange' ? 'btn--black' : 'btn--yellow']} href={primary.href}>{primary.label}</a>
      {secondary && <a class="btn btn--outline" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section);
  }
  .cta--black {
    border-top: 1px solid var(--rule);
  }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .cta__copy {
    max-width: 38rem;
  }
  .cta__title {
    font-size: var(--fs-h1);
    margin-bottom: var(--space-3);
  }
  .cta__body {
    margin: 0;
  }
</style>
